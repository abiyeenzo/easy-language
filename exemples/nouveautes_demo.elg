# Verifie toutes les nouveautes recentes du langage en un seul script :
# importe sans chemin, module texte, module temps, fermetures (closures),
# ambiguite "3 -4" levee, et un sanity check des autres modules standard.
#
# Le module gui (fenetre_creer/bouton/etiquette/champ_texte/sur_clic/
# executer, de vraies fenetres Win32) n'est pas teste ici : il ne
# fonctionne que sous Windows, et ce script doit rester executable sur
# n'importe quelle plateforme. Exemple complet dans bibliotheque/gui.elg.
# gui.message/gui.question (les boites de dialogue) sont testees plus
# bas, elles fonctionnent partout (repli console hors Windows).

importe math
importe os
importe texte
importe temps
importe gui

soit echecs = 0

fonction verifier(nom attendu obtenu):
    si attendu == obtenu alors:
        affiche "  ok " + nom
    sinon:
        affiche "  ECHEC " + nom + " : attendu " + texte(attendu) + ", obtenu " + texte(obtenu)
        echecs = echecs + 1

affiche "=== module texte ==="
verifier("decouper" ["a" "b" "c"] decouper("a,b,c" ","))
verifier("joindre" "x-y-z" joindre(["x" "y" "z"] "-"))
verifier("remplacer" "bonjour univers" remplacer("bonjour monde" "monde" "univers"))
verifier("majuscules" "ABC" majuscules("abc"))
verifier("minuscules" "abc" minuscules("ABC"))
verifier("rogner" "coucou" rogner("   coucou   "))
verifier("commence_par" vrai commence_par("bonjour" "bon"))
verifier("finit_par" vrai finit_par("bonjour" "jour"))
verifier("sous_texte" "bonj" sous_texte("bonjour" 0 4))
verifier("inverse" "fedcba" inverse("abcdef"))
verifier("position" 3 position("bonjour" "jour"))
verifier("contient_texte" faux contient_texte("bonjour" "xyz"))
verifier("module texte.majuscules" "VIA MODULE" texte.majuscules("via module"))

affiche "=== module temps ==="
verifier("annee epoque" 1970 annee(0))
verifier("mois epoque" 1 mois(0))
verifier("jour epoque" 1 jour(0))
verifier("jour_semaine epoque (jeudi)" 4 jour_semaine(0))
verifier("formater" "1970-01-01" formater(0 "%Y-%m-%d"))
soit maintenant_h = maintenant()
verifier("maintenant plausible" vrai maintenant_h > 1700000000)
verifier("module temps.annee" 1970 temps.annee(0))

affiche "=== importe <nom> sans chemin ==="
verifier("math.racine" 4 math.racine(16))
verifier("math.max" 9 math.max(3 9))
verifier("os.repertoire_courant non vide" vrai longueur(os.repertoire_courant()) > 0)

affiche "=== fermetures (closures) ==="
fonction creer_compteur():
    soit n = 0
    fonction incrementer():
        n = n + 1
        retourne n
    retourne incrementer

soit compteur_a = creer_compteur()
soit compteur_b = creer_compteur()
verifier("fermeture a, 1er appel" 1 compteur_a())
verifier("fermeture a, 2e appel" 2 compteur_a())
verifier("fermeture b independante" 1 compteur_b())
verifier("fermeture a toujours independante" 3 compteur_a())

fonction fabrique(depart):
    fonction ajouter(x):
        retourne depart + x
    retourne ajouter

soit plus5 = fabrique(5)
soit plus10 = fabrique(10)
verifier("fermeture imbriquee plus5" 6 plus5(1))
verifier("fermeture imbriquee plus10" 11 plus10(1))
verifier("fermeture imbriquee plus5 encore" 105 plus5(100))

affiche "=== ambiguite '3 -4' levee ==="
fonction deux_arguments(a b):
    retourne [a b]

verifier("espace avant, colle apres : deux arguments" [3 -4] deux_arguments(3 -4))
verifier("espaces des deux cotes : reste une soustraction" -1 3 - 4)
verifier("sans espace : reste une soustraction" -1 3-4)
verifier("double moins : reste 3 - (-4)" 7 3 - -4)
verifier("moins unaire directement en argument" "bon" sous_texte("bonjour" -5 3))

affiche "=== bilan ==="
si echecs == 0 alors:
    affiche "tout est bon (0 echec)"
sinon:
    affiche texte(echecs) + " echec(s)"
